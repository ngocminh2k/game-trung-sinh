# SERVER-PROXY-ONLY configuration. These variables are read by a server-side
# AI narration proxy (not yet implemented) and must NEVER be prefixed with
# VITE_ — anything VITE_-prefixed is inlined into the browser bundle and would
# be publicly exposed. No actual secret values belong in this repository.
AI_BASE_URL=your-ai-endpoint-url-here
AI_MODEL=your-model-name-here
AI_API_KEY=your-api-key-here

# Public (safe to inline) settings. The canonical player-facing title is fixed:
# 'Phế Căn Ký / Tale of the Broken Root'
VITE_DEFAULT_SEED=ink-and-jade
